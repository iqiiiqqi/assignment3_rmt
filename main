\title{Application of Machine Learning Algorithms and Big Data Analysis to Detect Fraudulent Transactions in the Banking Sector}
\author{\IEEEauthorblockN{Zhaniya Askarkyzy and Sabina Saiyn}
\IEEEauthorblockA{Department of Artificial Intelligence and Data Science, Astana IT University, Astana, Kazakhstan\\
\{242408, 241889\}@astanait.edu.kz}}
